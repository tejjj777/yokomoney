      "short_name": "Scan receipt",
      "url": "./index.html#do/scan-receipt",
      "icons": [
        {
          "src": "assets/sc-receipt.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Paste a bank message",
