{
  "name": "YOKO! Student",
  "short_name": "YOKO! Student",
  "description": "Plan your paycheck, pay off debt, budget and save. Everything stays on your device.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0A0A0A",
  "theme_color": "#0A0A0A",
